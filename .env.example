# your public app URL, e.g. https://example.com
APP_URL=http://localhost:3000
# optional: set this to your public source repository when redistributing this build
APP_SOURCE_URL=
APP_COMMIT_SHA=
PORT=3000

# Docker Compose uses this for the bundled PostgreSQL service
DOCMOST_DB_PASSWORD=change_me_db_password

# minimum of 32 characters. Generate one with: openssl rand -hex 32
APP_SECRET=REPLACE_WITH_LONG_SECRET

JWT_TOKEN_EXPIRES_IN=30d

# Direct local runs can use these defaults; docker-compose.yml overrides them automatically.
DATABASE_URL="postgresql://docmost:change_me_db_password@db:5432/docmost?schema=public"
REDIS_URL=redis://redis:6379

# Editor single-writer session fencing. Keep strict flags off until staged validation passes.
EDITOR_SESSION_ENABLED=false
EDITOR_SESSION_STRICT_WRITE=false
EDITOR_SESSION_COLLAB_VALIDATE=false
EDITOR_SESSION_FILE_ENABLED=false

# options: local | s3
STORAGE_DRIVER=local

# enable Backup & Restore UI/API; backups run locally by default unless BACKUP_S3_ENABLED=true
BACKUP_ENABLED=true

# backup artifact local path (set to a persistent mounted directory in Docker)
BACKUP_LOCAL_PATH=
BACKUP_STALE_JOB_MINUTES=
BACKUP_S3_ENABLED=false
BACKUP_S3_PREFIX=backups

# S3-compatible driver config (optional, e.g. AWS S3 / Tencent COS)
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_REGION=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=
AWS_S3_URL=

# default: 50mb (leave empty to use default)
FILE_UPLOAD_SIZE_LIMIT=50mb

# options: smtp | postmark
MAIL_DRIVER=smtp
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=SuperChat

# SMTP driver config
SMTP_HOST=127.0.0.1
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_IGNORETLS=false

# Postmark driver config
POSTMARK_TOKEN=

# for custom drawio server
DRAWIO_URL=

# Gotenberg URL for upstream PDF export jobs
GOTENBERG_URL=

# Optional Chromium path for self-hosted server-side PDF export
PDF_EXPORT_CHROMIUM_PATH=

# optional: WeChat H5 share enhancement for pages opened inside WeChat
WECHAT_APP_ID=
WECHAT_APP_SECRET=

DISABLE_TELEMETRY=false

# Enable debug logging in production (default: false)
DEBUG_MODE=false

# Log database queries
DEBUG_DB=false

# Log http requests
LOG_HTTP=false
